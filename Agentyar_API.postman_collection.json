{
  "info": {
    "name": "Agentyar API",
    "description": "API endpoints for Agentyar - AI Agents Platform",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Sign Up",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"علی احمدی\",\n  \"email\": \"ali@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/signup",
              "host": ["{{base_url}}", "api", "auth", "signup"],
              "protocol": "http"
            },
            "description": "Create a new user account"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ali@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}", "api", "auth", "login"],
              "protocol": "http"
            },
            "description": "Login to existing account"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/auth/logout",
              "host": ["{{base_url}}", "api", "auth", "logout"],
              "protocol": "http"
            },
            "description": "Logout from current session"
          }
        }
      ]
    },
    {
      "name": "Agents",
      "item": [
        {
          "name": "List Active Agents",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/agents",
              "host": ["{{base_url}}", "api", "agents"],
              "protocol": "http"
            },
            "description": "Get list of all active agents"
          }
        },
        {
          "name": "Run Agent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agent_id\": \"sales-content\",\n  \"input\": {\n    \"product_name\": \"نرم‌افزار مدیریت فروش\",\n    \"target_audience\": \"صاحبان کسب‌وکارهای کوچک\",\n    \"problem\": \"کاهش فروش\",\n    \"features\": \"قیمت مناسب، سرعت، پشتیبانی\",\n    \"tone\": \"حرفه‌ای\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/agents/run",
              "host": ["{{base_url}}", "api", "agents", "run"],
              "protocol": "http"
            },
            "description": "Execute an agent with user input (requires authentication)"
          }
        },
        {
          "name": "Activate Agent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"agent_id\": \"sales-content\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/agents/activate",
              "host": ["{{base_url}}", "api", "agents", "activate"],
              "protocol": "http"
            },
            "description": "Activate/subscribe to an agent (requires authentication)"
          }
        }
      ]
    },
    {
      "name": "Agent Runs",
      "item": [
        {
          "name": "Get Runs History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/agent-runs",
              "host": ["{{base_url}}", "api", "agent-runs"],
              "protocol": "http"
            },
            "description": "Get user's agent run history (last 50 runs, requires authentication)"
          }
        },
        {
          "name": "Get Single Run",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/agent-runs/{{run_id}}",
              "host": ["{{base_url}}", "api", "agent-runs", "{{run_id}}"],
              "protocol": "http"
            },
            "description": "Get details of a specific agent run (requires authentication)"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "run_id",
      "value": "your-run-id-here",
      "type": "string"
    }
  ]
}
